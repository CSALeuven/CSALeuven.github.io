---
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventCard from '../components/EventCard.astro';
import GuideCard from '../components/GuideCard.astro';
import NewsCard from '../components/NewsCard.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import CTASection from '../components/CTASection.astro';
import { partners } from '../data/partners';
import { homeIntro, homeThemes } from '../data/about';
import { getEvents, getGuides, getNews, isUpcoming, eventStatus } from '../lib/content';
import { href, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const events = await getEvents(lang), confirmed = events.filter(e => isUpcoming(e));
const recent = events.filter(e => eventStatus(e) === 'past').reverse();
const shownEvents = confirmed.length ? confirmed.slice(0, 3) : recent.slice(0, 3);
const guides = (await getGuides(lang)).filter(g => ['arrival','housing','transport','university','healthcare','banking','daily-life'].includes(g.data.key));
const news = (await getNews(lang)).slice(0,3);
---
<Hero lang={lang} />
<section class="section container"><SectionHeading eyebrow={confirmed.length ? "WHAT’S ON / 学联活动" : "RECENT MEMORIES / 往期活动"} title={t(lang, '相聚，总有好理由。', 'Good reasons to get together.')} link={href(lang,'events')} linkText={t(lang,'全部活动','All events')} />{!confirmed.length && <p class="notice compact">{t(lang,'暂无已确认的近期活动。先回顾最近的相聚，新的活动将另行公告。','No upcoming events have been confirmed. Revisit our recent gatherings while we prepare the next announcement.')}</p>}<div class="event-grid">{shownEvents.map((event,index) => <EventCard event={event} lang={lang} index={index} />)}</div></section>
<section class="new-home-section"><div class="container"><SectionHeading eyebrow="NEW TO LEUVEN / 新生指南" title={t(lang,'新城市，慢慢来。','New city. One step at a time.')} description={t(lang,'把初来乍到的问号，变成可以开始的下一步。','Turn the first questions into a few clear next steps.')} link={href(lang,'new-students')} linkText={t(lang,'完整新生指南','The newcomer guide')} /><div class="guide-grid">{guides.map((guide,index) => <GuideCard guide={guide} lang={lang} index={index} />)}</div></div></section>
<section class="section container about-home"><div><p class="eyebrow section-eyebrow">OUR COMMUNITY / 关于学联</p><h2>{t(lang,'连接你我，\n也连接这座城。','A connection to each other.\nAnd to the city.')} </h2><a class="text-link" href={href(lang,'about')}>{t(lang,'认识 CSAL','Get to know CSAL')}<span aria-hidden="true">→</span></a></div><div><p class="about-lead">{homeIntro[lang]}</p><div class="mission-list">{homeThemes.map((theme,i)=><div><span>0{i+1}</span><div><h3>{theme.heading[lang]}</h3><p>{theme.text[lang]}</p></div></div>)}</div></div></section>
<section class="section section-top-border container"><SectionHeading eyebrow="THE LATEST / 社区动态" title={t(lang,'最近，值得关注。','From the community.')} link={href(lang,'news')} linkText={t(lang,'全部动态','All updates')} />{news.map(entry=><NewsCard entry={entry} lang={lang} />)}</section>
<section class="section section-top-border container"><SectionHeading eyebrow="BETTER TOGETHER / 合作伙伴" title={t(lang,'让连接，走得更远。','More possibilities, together.')} description={t(lang,'合作伙伴信息待确认。以下为预留展示位，不代表已有合作或机构背书。','Partner details are awaiting confirmation. These placeholders do not indicate existing partnerships or institutional endorsement.')} link={href(lang,'partners')} linkText={t(lang,'合作交流','Connect with us')} /><div class="partner-grid">{partners.map(partner=><PartnerLogo partner={partner} lang={lang} />)}</div></section>
<CTASection lang={lang} />
