---
import PageIntro from '../components/PageIntro.astro';
import TeamMember from '../components/TeamMember.astro';
import { team } from '../data/team';
import { site } from '../data/site';
import { href, t, type Lang } from '../lib/i18n';
import { Content as HandbookAbout } from '../content/handbook-notes/about.md';
const { lang } = Astro.props as { lang: Lang };
const missions = [
 [t(lang,'同学支持','Student support'),t(lang,'分享有用信息，为相互帮助留出空间。','Sharing useful information and creating space for mutual support.')],
 [t(lang,'社区活动','Community events'),t(lang,'让同学有机会认识彼此，交流经验。','Opportunities to meet fellow students and exchange experiences.')],
 [t(lang,'文化交流','Cultural exchange'),t(lang,'分享不同的故事，理解多元的校园生活。','Sharing stories and perspectives across a diverse campus community.')],
 [t(lang,'新生协助','New-student assistance'),t(lang,'整理可靠的入门资源，帮助新同学找到方向。','Organising reliable starting points for students finding their way.')],
 [t(lang,'校园连接','Campus connection'),t(lang,'连接同学、校园与鲁汶生活的信息入口。','Connecting students with information about campus and life in Leuven.')],
];
---
<PageIntro lang={lang} eyebrow="ABOUT CSAL / 关于学联" title={t(lang,'连接你我，连接鲁汶。','Connecting people. Connecting Leuven.')} description={site.name[lang]} />
<section class="container page-section about-intro"><div class="about-logo"><img src={site.logo} width="551" height="570" alt="CSAL 鲁汶中国学生学者联合会 logo" /></div><div><h2>{t(lang,'在异乡，也有同行的人。','A community along the way.')}</h2><p>{t(lang,'CSAL 是鲁汶中国学生学者联合会。在这里，我们希望让中国学生与学者更容易认识彼此、分享经验，并参与校园与城市生活。','CSAL is the Chinese Students and Scholars Association Leuven. We aim to make it easier for Chinese students and scholars to meet, share experiences and connect with campus and city life.')}</p><p>{site.disclaimer[lang]}</p><p class="resource-note">{t(lang,'协会详细介绍与正式使命表述待委员会确认。','The detailed association profile and formal mission statement are awaiting committee confirmation.')}</p></div></section>
<section class="container page-section"><div class="subheading"><h2>{t(lang,'我们希望做的事','Our areas of focus')}</h2></div><div class="focus-grid">{missions.map(([title,copy],i)=><article><span class="guide-number">0{i+1}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
<section class="container page-section"><div class="subheading"><h2>{t(lang,'委员会与团队','Committee & team')}</h2></div><div class="team-grid">{team.map(member=><TeamMember member={member} lang={lang} />)}</div></section>
<section class="container page-section history-section"><div><p class="eyebrow section-eyebrow">OUR STORY / 学联历程</p><h2>{t(lang,'共同写下的故事。','A story written together.')}</h2></div><div><p>{t(lang,'历史信息待补充。创立时间、历届委员会与重要活动记录将在核实后发布。','History details are awaiting confirmation. Founding information, previous committees and milestones will be published after verification.')}</p><a class="text-link" href={href(lang,'contact')}>{t(lang,'与我们联系','Get in touch')}<span aria-hidden="true">→</span></a></div></section>
<section class="container page-section"><details class="notice"><summary>{t(lang,'阅读 2024 手册中的学联历史介绍（待复核）','Read the historical CSAL profile from the 2024 handbook (awaiting review)')}</summary>{lang==='en'&&<p>The historical source below is in Chinese. A reviewed English translation is pending.</p>}<div class="prose" lang="zh-CN"><HandbookAbout /></div></details></section>
