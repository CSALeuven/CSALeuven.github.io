---
import PageIntro from '../components/PageIntro.astro';
import EventCard from '../components/EventCard.astro';
import { getEvents, isUpcoming, eventStatus } from '../lib/content';
import { eventCalendarDate } from '../lib/event-dates';
import { href, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
const entries = await getEvents(lang);
const upcoming = entries.filter(e => isUpcoming(e));
const samples = entries.filter(e => e.data.status === 'sample');
const archive = entries.filter(e => ['past','cancelled'].includes(eventStatus(e))).reverse();
const years = [...new Set(archive.map(e => eventCalendarDate(e.data)!.slice(0,4)))];
---
<PageIntro lang={lang} eyebrow="EVENTS / 学联活动" title={t(lang,'让相聚成为日常。','Make room for getting together.')} description={t(lang,'活动公告、社区相聚与文化交流，从这里了解。','Event announcements, community gatherings and cultural exchange. Find what’s happening here.')} />
<section class="container page-section"><div class="subheading"><h2>{t(lang,'即将举行','Coming up')}</h2><span>{t(lang,'以正式公告为准','Confirmed announcements')}</span></div>{upcoming.length ? <div class="event-grid">{upcoming.map((event,index)=><EventCard event={event} lang={lang} index={index} />)}</div> : <div class="empty-state"><p class="empty-mark" aria-hidden="true">—</p><h3>{t(lang,'下一次相聚，敬请期待。','Our next gathering is still to come.')}</h3><p>{t(lang,'暂时没有已确认的近期活动。关注官方账号，获取后续公告。','No upcoming events have been confirmed yet. Follow our official channels for announcements.')}</p><a class="text-link" href={href(lang,'contact')}>{t(lang,'关注 CSAL','Follow CSAL')}<span aria-hidden="true">↗</span></a></div>}</section>
{samples.length > 0 && <section class="container page-section"><div class="subheading"><h2>{t(lang,'示例活动','Example events')}</h2></div><p class="notice">{t(lang,'以下仅为版式示例，不是已确认活动，尚未开放报名。','The following entries are layout samples, not confirmed events. Registration is not open.')}</p><div class="event-grid">{samples.map((event,index)=><EventCard event={event} lang={lang} index={index} />)}</div></section>}
{archive.length > 0 && <section class="container page-section" aria-labelledby="archive-heading"><div class="subheading"><h2 id="archive-heading">{t(lang,'往期活动','Past events')}</h2><span>{t(lang,`${archive.length} 场相聚，按年份回顾`,`${archive.length} events, collected by year`)}</span></div><nav class="archive-years" aria-label={t(lang,'按年份浏览活动','Browse events by year')}>{years.map(year=><a href={`#year-${year}`}>{year}<span>{archive.filter(e=>eventCalendarDate(e.data)!.startsWith(year)).length}</span></a>)}</nav>{years.map(year=><section class="archive-year" aria-labelledby={`year-${year}`}><h3 id={`year-${year}`}>{year}</h3><div class="event-grid">{archive.filter(e=>eventCalendarDate(e.data)!.startsWith(year)).map((event,index)=><EventCard event={event} lang={lang} index={index} />)}</div></section>)}</section>}
