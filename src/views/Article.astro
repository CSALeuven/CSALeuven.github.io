---
import { render, type CollectionEntry } from 'astro:content';
import { href, t, formatDate, type Lang } from '../lib/i18n';
import { eventStatus } from '../lib/content';
import { eventDateTime, formatEventDate } from '../lib/event-dates';
import EventGallery from '../components/EventGallery.astro';
import NewsSource from '../components/NewsSource.astro';
interface Props { lang: Lang; entry: CollectionEntry<'events'> | CollectionEntry<'guides'> | CollectionEntry<'news'>; }
const { lang, entry } = Astro.props;
const { Content } = await render(entry);
const event = entry.collection === 'events' ? entry : null;
const guide = entry.collection === 'guides' ? entry : null;
const news = entry.collection === 'news' ? entry : null;
const backPath = guide ? guide.data.category : entry.collection;
const backLabel = guide ? t(lang,'返回指南','Back to guides') : event ? t(lang,'全部活动','All events') : t(lang,'全部动态','All updates');
const sample = event?.data.status === 'sample' || news?.data.sample;
const status = event && eventStatus(event);
---
<div class="container article-shell"><a class="breadcrumb" href={href(lang,backPath)}>← {backLabel}</a><div class="article-header"><p class="eyebrow section-eyebrow">{guide?.data.label ?? event?.data.category ?? news?.data.category}</p><h1>{entry.data.title}</h1>{event && <p class="article-other-title" lang={lang==='zh'?'en':'zh-CN'}>{event.data.titleOther}</p>}<p class="page-description">{entry.data.summary}</p>{guide && <p class="article-date">{t(lang,'资源核对：','Resources checked: ')}<time datetime={guide.data.reviewed.toISOString()}>{formatDate(guide.data.reviewed,lang)}</time></p>}{news && <p class="article-date">{news.data.sourceName && t(lang, '原文发布（比利时时间）：', 'Source published (Belgium time): ')}<time datetime={news.data.date.toISOString()}>{formatDate(news.data.date,lang)}</time></p>}</div>
{sample && <p class="notice">{t(lang,'示例内容 · 仅用于展示版式，不代表已举办或已确认的活动。','Sample content · Demonstrates the layout and does not represent a past or confirmed event.')}</p>}
{news?.data.sourceName && news.data.sourceUrl && <NewsSource lang={lang} name={news.data.sourceName} url={news.data.sourceUrl} />}
{event?.data.coverImage && <img class="article-cover event-article-cover" src={event.data.coverImage} alt={event.data.coverAlt || event.data.title} width={event.data.coverWidth ?? 1200} height={event.data.coverHeight ?? 760} />}
<div class="article-layout"><article class="prose"><Content />{event && <Fragment><EventGallery photos={event.data.gallery} lang={lang} />{event.data.sources.length > 0 && <section class="event-sources" aria-labelledby="original-sources"><h2 id="original-sources">{t(lang,'原始推送','Original WeChat articles')}</h2><ul>{event.data.sources.map(source => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span class="sr-only">{t(lang,'（新标签页）',' (Chinese, new tab)')}</span></a><span class="source-published">{t(lang,'原文发布：','Source published: ')}<time datetime={source.publishedAt.toISOString()}>{new Intl.DateTimeFormat(lang==='zh'?'zh-CN':'en-GB',{year:'numeric',month:'long',day:'numeric',timeZone:'Asia/Shanghai'}).format(source.publishedAt)}</time>{t(lang,'（北京时间）',' (Beijing time)')}</span></li>)}</ul></section>}</Fragment>}</article><aside class="article-sidebar">
{event && <div><h2>{t(lang,'活动信息','Event details')}</h2><dl><dt>{t(lang,'日期','Date')}</dt><dd><time datetime={eventDateTime(event.data)}>{formatEventDate(event.data,lang,true)}</time></dd>{event.data.location && <Fragment><dt>{t(lang,'地点','Location')}</dt><dd>{event.data.location}</dd></Fragment>}<dt>{t(lang,'状态','Status')}</dt><dd>{status==='sample'?t(lang,'示例 · 未开放报名','Sample · Registration not open'):status==='cancelled'?t(lang,'已取消','Cancelled'):status==='past'?t(lang,'已结束','Past event'):t(lang,'即将举行','Upcoming')}</dd></dl>{event.data.registrationUrl && status === 'upcoming' ? <a class="button primary" href={event.data.registrationUrl} target="_blank" rel="noopener noreferrer">{t(lang,'前往报名 ↗','Register ↗')}</a> : <p class="resource-note">{status === 'past' ? t(lang,'本页为往期活动回顾。','This page records a completed event.') : t(lang,'请关注官方渠道了解正式安排。','Follow the official channels for confirmed arrangements.')}</p>}</div>}
{guide && <div><h2>{t(lang,'官方资源','Official resources')}</h2><ul class="source-list">{guide.data.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true">↗</span><span class="sr-only">{t(lang,'（新标签页）',' (new tab)')}</span></a></li>)}</ul><p class="resource-note">{t(lang,'请以官方页面的最新说明为准。','Check the official pages for current information.')}</p></div>}
{news && <div><h2>{t(lang,'保持联系','Stay connected')}</h2><p>{t(lang,'从官方账号获取学联动态。','Find CSAL updates through our official channels.')}</p></div>}
<a class="text-link" href={href(lang,'contact')}>{t(lang,'联系 CSAL','Contact CSAL')}<span aria-hidden="true">→</span></a></aside></div>
<a class="text-link article-back" href={href(lang,backPath)}>← {backLabel}</a></div>
