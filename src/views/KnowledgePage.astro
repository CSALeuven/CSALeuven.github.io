---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import KnowledgeSearch from '../components/KnowledgeSearch.astro';
import KnowledgeChecklist from '../components/KnowledgeChecklist.astro';
import PackingChecklist from '../components/PackingChecklist.astro';
import { getKnowledge, getKnowledgeUpdates } from '../lib/knowledge';
import { t, href, type Lang } from '../lib/i18n';
import { categories, sourceNotice, reviewLabels, firstWeek, contractChecks } from '../data/knowledge';
import '../styles/knowledge.css';
const { lang, slug } = Astro.props as {lang:Lang;slug:string};
const entries=await getKnowledge(), entry=entries.find(e=>e.data.key===slug);
const category=categories.find(c=>c.key===(entry?.data.category??slug));
const archive=slug==='handbook-2024';
const hasTranslations=Object.keys(import.meta.glob('../content/knowledge-translations/**/*.md')).length>0;
const translation=lang==='en'&&entry&&hasTranslations?(await getCollection('knowledgeTranslations')).find(e=>e.data.key===entry.data.key):undefined;
const rendered=entry?await render(translation??entry):undefined;
const Content=rendered?.Content;
const update=lang==='en'&&entry?(await getKnowledgeUpdates()).find(e=>e.data.key===entry.data.key):undefined;
const renderedUpdate=update?await render(update):undefined;
const UpdateContent=renderedUpdate?.Content;
const emergencyHelp={
  zh:'如需救护车、消防等紧急援助，请拨打 112，并按接线员指示说明位置和情况。仅因交通不便而无法自行前往医院，并不等于紧急情况；非紧急就医请联系家庭医生或当地值班医疗服务。',
  en:'Call 112 for urgent ambulance, fire or other emergency help and follow the operator’s instructions about your location and situation. Transport difficulty alone does not make a medical problem an emergency; contact a GP or local out-of-hours service for non-urgent care.',
};
const title=entry?(lang==='zh'?entry.data.titleZh:entry.data.titleEn):archive?t(lang,'2024 新生手册 PDF','2024 Student Handbook PDF'):category?.[lang]??'';
const description=entry?(lang==='zh'?entry.data.descriptionZh:entry.data.descriptionEn):archive?t(lang,'查看或下载 2024 年版新生手册。','View or download the 2024 Student Handbook.'):category?(lang==='zh'?category.descriptionZh:category.descriptionEn):'';
const siblings=entries.filter(e=>e.data.category===category?.key);
const related=entry?entry.data.related.map(key=>entries.find(e=>e.data.key===key)!):[];
const articleHref=(key:string)=>href(lang,`new-students/${key}`);
---
<Layout lang={lang} path={`new-students/${slug}`} title={title} description={description} noindex={Boolean(entry&&lang==='en'&&!translation)}>
  <div class="container kb-page">
    <nav class="kb-breadcrumbs" aria-label={t(lang,'当前位置','Breadcrumb')}><a href={href(lang,'new-students')}>{t(lang,'新生指南','Student guide')}</a>{entry&&category&&<><span aria-hidden="true">/</span><a href={articleHref(category.key)}>{category[lang]}</a></>}<span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
    {entry ? <>
      <header class="kb-article-header"><p class="kb-status">{reviewLabels[entry.data.reviewStatus][lang]}{entry.data.timeSensitive&&` · ${t(lang,'含时效性信息','Time-sensitive information')}`}</p><h1>{title}</h1><p class="kb-subtitle">{description}</p><p class="kb-small">{entry.data.lastReviewed?`${t(lang,'最近复核','Last reviewed')}: ${entry.data.lastReviewed.toISOString().slice(0,10)}`:t(lang,'全文尚未进行现行政策复核','The full article has not been reviewed against current policy')}</p></header>
      <p class="kb-source-notice">{sourceNotice[lang]}</p>
      {entry.data.approvedUpdateIds.length>0&&<p class="kb-small">{t(lang,'本页已对部分事项作复核，其余内容仍含 2024 年历史信息；不代表全文已核实。','Selected topics have been reviewed. The remaining material includes historical information from 2024; the full article has not been verified.')}</p>}
      {lang==='en'&&!translation&&<p class="kb-translation-note">{update?'English translations of the reviewed topics appear below. The remaining article and checklists are in Chinese; a full English translation is not yet available.':'English discovery summary only. The article and checklists below are the Chinese original; a reviewed English translation is not yet available.'} {update&&<a href="#approved-updates">Read the English text ↓</a>} <a href="#chinese-article">Read the Chinese article ↓</a></p>}
      {translation&&<p class="kb-small">Reviewed English translation · {translation.data.lastReviewed.toISOString().slice(0,10)} · {translation.data.reviewer}</p>}
      {entry.data.category==='transport'&&<p class="kb-source-notice">{t(lang,'票价、票制及交通规则可能变化，请出行前查询运营方最新信息。','Fares, ticket products and traffic rules may change. Check the operator’s latest information before travelling.')}</p>}
      {entry.data.key==='healthcare/emergency'&&<div class="kb-emergency"><strong>112</strong><div><h2>{t(lang,'紧急求助','Emergency help')}</h2><p>{emergencyHelp[lang]}</p><a href="tel:112">{t(lang,'拨打 112','Call 112')} ↗</a></div></div>}
      <div class="kb-article-grid"><aside class="kb-article-nav"><details open><summary>{t(lang,'本页内容','On this page')}</summary><nav aria-label={t(lang,'文章目录','Article contents')}>{update&&<a href="#approved-updates">English summary</a>}<a href="#quick-answer">{t(lang,'先看这里','Quick answer')}</a>{entry.data.key==='before-arrival/packing'&&<a href="#interactive-checklist">{t(lang,'行李清单','Packing checklist')}</a>}{['arrival/first-week','housing/contracts'].includes(entry.data.key)&&<a href="#interactive-checklist">{t(lang,'检查清单','Checklist')}</a>}{rendered?.headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<a href="#sources">{t(lang,'官方信息与相关内容','Official information and related reading')}</a></nav></details><a class="kb-return-search" href={href(lang,'new-students')}>{t(lang,'← 搜索其他问题','← Search another question')}</a></aside>
      <article id="article-content" class="kb-article-content" lang={translation?'en':'zh-CN'}>
        {UpdateContent&&<section id="approved-updates" class="prose kb-prose" lang="en" aria-labelledby="updates-title"><h2 id="updates-title">English summary</h2><p>This summary covers the reviewed topics only. The Chinese article below includes them alongside the remaining information.</p><UpdateContent/></section>}
        <div id="chinese-article">
        <div id="quick-answer" class="kb-quick-answer"><h2>{t(lang,'先看这里','Quick answer')}</h2><p>{translation?.data.quickAnswer??entry.data.quickAnswer}</p></div>
        {entry.data.key==='before-arrival/packing'&&<div id="interactive-checklist"><PackingChecklist lang={lang}/></div>}
        {entry.data.key==='arrival/first-week'&&<div id="interactive-checklist"><KnowledgeChecklist lang={lang} id="first-week" title={t(lang,'初到鲁汶第一周','Your first week')} items={firstWeek}/></div>}
        {entry.data.key==='housing/contracts'&&<div id="interactive-checklist"><KnowledgeChecklist lang={lang} id="contract" title={t(lang,'签租房合同前检查清单','Before signing a rental contract')} items={contractChecks.map((title,i)=>({id:`contract-${i+1}`,title}))}/></div>}
        <div class="prose kb-prose">{Content&&<Content/>}</div>
        </div>
      </article></div>
      <section id="sources" class="kb-article-sources"><div><h2>{t(lang,'官方信息','Official information')}</h2><p class="kb-small">{t(lang,'具体要求与最新安排，请查看相关官方页面。','Check the relevant official pages for current requirements and arrangements.')}</p><ul class="kb-official-links">{entry.data.officialSources.map(s=><li><a href={s.url}>{s.label} ↗</a></li>)}</ul></div><div><h2>{t(lang,'接下来可能用得上','Related reading')}</h2><div class="kb-related">{related.map(e=><a href={articleHref(e.data.key)}><h3>{lang==='zh'?e.data.titleZh:e.data.titleEn}</h3><p>{lang==='zh'?e.data.descriptionZh:e.data.descriptionEn}</p><span aria-hidden="true">→</span></a>)}</div></div></section>
    </> : archive ? <>
      <header class="kb-article-header"><p class="eyebrow section-eyebrow">PDF ARCHIVE / PDF 档案</p><h1>{title}</h1><p class="kb-subtitle">{description}</p></header><p class="kb-source-notice">{sourceNotice[lang]}</p>
      <div class="kb-archive-content"><h2>{t(lang,'下载 / 查看《鲁汶学联新生手册 2024》原版 PDF','Download or view the original 2024 handbook PDF')}</h2><p>{t(lang,'35 页 · 约 2.5 MB · 保留原始文件','35 pages · approximately 2.5 MB · original file preserved')}</p><div class="button-row"><a class="button button-primary" href="/documents/csal-student-handbook-2024.pdf">{t(lang,'查看原版 PDF','View PDF')} ↗</a><a class="button button-secondary" download href="/documents/csal-student-handbook-2024.pdf">{t(lang,'下载 PDF','Download PDF')} ↓</a></div>
      <h2>{t(lang,'阅读提示','Reading notes')}</h2><p>{t(lang,'这份 PDF 为 2024 年版本，价格、流程、机构和服务信息可能已变化。请结合在线指南的复核提示，并向相关机构确认最新要求。','This PDF dates from 2024. Prices, procedures, institutions and services may have changed. Check the review notes in the online guide and confirm current requirements with the relevant organisation.')}</p><p><a class="text-link" href={href(lang,'about')}>{t(lang,'了解鲁汶学联','About CSAL')} →</a></p></div>
    </> : category && <>
      <header class="kb-article-header"><p class="eyebrow section-eyebrow">NEW STUDENT GUIDE / 新生指南</p><h1>{category[lang]}</h1><p class="kb-subtitle">{description}</p></header><KnowledgeSearch lang={lang}/>
      {category.key==='healthcare'&&<div class="kb-emergency"><strong>112</strong><div><h2>{t(lang,'紧急求助','Emergency help')}</h2><p>{emergencyHelp[lang]}</p><a href={articleHref('healthcare/emergency')}>{t(lang,'急诊与紧急求助说明','Emergency guide')} →</a></div></div>}
      {category.key==='housing'&&<a class="kb-feature-link" href={articleHref('housing/contracts')}><span>{t(lang,'签约前先检查','Before you sign')}</span><h2>{t(lang,'租房合同检查清单','Rental contract checklist')} →</h2></a>}
      {category.key==='healthcare'&&<a class="kb-feature-link" href={articleHref('arrival/health-insurance')}><h2>{t(lang,'健康保险与医保','Health insurance')} →</h2></a>}
      <div class="kb-article-list">{siblings.map(e=><a href={articleHref(e.data.key)}><p class="kb-status">{reviewLabels[e.data.reviewStatus][lang]}</p><h2>{lang==='zh'?e.data.titleZh:e.data.titleEn}</h2><p>{lang==='zh'?e.data.descriptionZh:e.data.descriptionEn}</p><span aria-hidden="true">↗</span></a>)}</div><p class="kb-source-notice">{sourceNotice[lang]}</p>
    </>}
  </div>
</Layout>
<script>
  if (window.matchMedia('(max-width: 767px)').matches) {
    const contents = document.querySelector<HTMLDetailsElement>('.kb-article-nav details');
    if (contents) contents.open = false;
  }
</script>
