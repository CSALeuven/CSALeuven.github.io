---
import { site } from '../data/site';
import { href, nav, t, type Lang } from '../lib/i18n';
import SocialLinks from './SocialLinks.astro';
const { lang } = Astro.props as { lang: Lang };
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top"><div><a class="footer-wordmark" href={href(lang)}>CSAL<span>鲁汶学联</span></a><p>{site.name[lang]}</p></div><SocialLinks lang={lang} /></div>
    <nav class="footer-nav" aria-label={t(lang, '页脚导航', 'Footer navigation')}>{nav.map(item => <a href={href(lang, item.path)}>{item[lang]}</a>)}</nav>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} CSAL Leuven</span><p>{site.disclaimer[lang]}</p></div>
  </div>
</footer>
