---
import { site } from '../data/site';
import { t, type Lang } from '../lib/i18n';
import SocialLinks from './SocialLinks.astro';
const { lang } = Astro.props as { lang: Lang };
---
<section class="connect-section" id="wechat"><div class="container connect-grid"><div><p class="eyebrow">STAY CONNECTED / 保持联系</p><h2>{t(lang, '一声你好，\n一个新的连接。', 'A hello can be\nthe start of something.')}</h2><p>{t(lang, '关注鲁汶学联，获取活动公告与社区动态。\n欢迎新同学，也欢迎一直在这里的你。', 'Follow CSAL for event announcements and community updates. New to Leuven or already at home here — you’re welcome.')}</p><SocialLinks lang={lang} />{site.email && <a class="email-link" href={`mailto:${site.email}`}>{site.email}</a>}</div><figure class="wechat-card"><a href={site.wechatQr} target="_blank" rel="noopener noreferrer" aria-label={t(lang, '在新标签页查看完整微信公众号二维码', 'Open the full WeChat QR code in a new tab')}><img src={site.wechatQr} width="1164" height="1164" loading="lazy" alt="鲁汶学联 CSAL 微信公众号二维码" /></a><figcaption><span>{t(lang, '微信扫码关注 · 打开二维码原图', 'Scan in WeChat · Open full image')}</span></figcaption></figure></div></section>
