---
import { site } from '../data/site';
import { href, t, type Lang } from '../lib/i18n';
const { lang } = Astro.props as { lang: Lang };
---
<section class="hero container">
  <div class="hero-copy">
    <p class="eyebrow"><span class="short-rule"></span> LEUVEN, BELGIUM · 鲁汶，比利时</p>
    <h1>{lang === 'zh' ? <Fragment>在鲁汶，<br /><em>遇见同路人。</em></Fragment> : <Fragment>Leuven.<br /><em>A place to belong.</em></Fragment>}</h1>
    <p class="hero-english" lang="en">Connecting Chinese students in Leuven.</p>
    <p class="hero-description">{t(lang, '服务同学，连接校园，融入鲁汶。\n从初来乍到，到把这座城市叫作家。', 'Supporting students, building community, and connecting Leuven. From your first day to finding your own place in the city.')}</p>
    <div class="button-row"><a class="button primary" href={href(lang, 'events')}>{t(lang, '探索学联活动', 'Explore events')}<span aria-hidden="true">↗</span></a><a class="button secondary" href={href(lang, 'new-students')}>{t(lang, '查看新生指南', 'New student guide')}<span aria-hidden="true">→</span></a></div>
  </div>
  <div class="hero-art" role="group" aria-label={t(lang, 'CSAL 鲁汶学联品牌展示', 'CSAL Leuven brand panel')}>
    <div class="art-top"><span>CSAL / LEUVEN</span><span>你好，鲁汶。</span></div>
    <div class="logo-mat"><img src={site.logo} width="551" height="570" alt={`${site.shortNames.en} ${site.officialNames.zh} logo`} /></div>
    <div class="art-bottom"><span class="art-caption">A little closer<br /><i>to home.</i></span><span class="art-caption-small">STUDENTS.<br />SCHOLARS.<br />COMMUNITY.</span></div>
  </div>
</section>
<nav class="intro-strip" aria-label={t(lang, '新生快捷入口', 'New student shortcuts')}><div class="container"><span>{t(lang, '从这里，开始你的鲁汶生活', 'Your Leuven chapter starts here')}</span><a href={href(lang, 'new-students')}>{t(lang, '行前准备', 'Before arrival')}<span aria-hidden="true">↗</span></a><a href={href(lang, 'guides/first-week')}>{t(lang, '初到第一周', 'Your first week')}<span aria-hidden="true">↗</span></a><a href={href(lang, 'contact')}>{t(lang, '找到我们的社区', 'Find our community')}<span aria-hidden="true">↗</span></a></div></nav>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .85fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding-block: 36px 40px;
  }
  .hero-copy { min-width: 0; }
  .hero h1 {
    font-size: clamp(42px, 4.2vw, 60px);
    line-height: 1.18;
    letter-spacing: -.055em;
    font-weight: 600;
    margin: 18px 0 14px;
  }
  .hero h1 em { font-style: normal; color: var(--red); }
  .hero-english { font: 20px/1.4 var(--serif); letter-spacing: -.02em; }
  .hero-description {
    font-size: 15px;
    color: var(--muted);
    white-space: pre-line;
    margin-top: 12px;
    max-width: 470px;
    line-height: 1.8;
  }
  .hero .button-row { margin-top: 20px; gap: 10px; }
  .hero .button { min-height: 46px; padding: 11px 18px; gap: 20px; }
  .hero-art {
    background: #eee7df;
    min-height: 320px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px 24px;
    position: relative;
    overflow: hidden;
  }
  .hero-art::before {
    content: '';
    position: absolute;
    border: 1px solid #dcd0c4;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    top: -140px;
    right: -170px;
    pointer-events: none;
  }
  .art-top { display: flex; justify-content: space-between; gap: 12px; font-size: 10px; letter-spacing: .08em; z-index: 1; }
  .logo-mat {
    background: white;
    align-self: center;
    width: 160px;
    padding: 14px 16px;
    box-shadow: 0 12px 24px #5744390a;
    transform: rotate(-5deg);
    margin: 14px 0;
    position: relative;
  }
  .logo-mat img { width: 100%; height: auto; }
  .art-bottom { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; }
  .art-caption { font: 30px/1.08 var(--serif); letter-spacing: -.04em; }
  .art-caption i { color: var(--red); }
  .art-caption-small { font-size: 9px; letter-spacing: .08em; line-height: 1.8; }
  .intro-strip { border-block: 1px solid var(--line); }
  .intro-strip > .container { display: grid; grid-template-columns: 1.4fr repeat(3, 1fr); align-items: center; min-height: 64px; }
  .intro-strip > .container > span { font-size: 13px; font-weight: 600; padding-right: 18px; }
  .intro-strip a { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 44px; padding: 10px 18px; border-left: 1px solid var(--line); font-size: 13px; }
  .intro-strip a:hover { color: var(--red); }
  @media (max-width: 1023px) {
    .hero { gap: 24px; padding-block: 28px 32px; }
    .hero h1 { font-size: 42px; }
    .hero-art { min-height: 300px; padding: 18px; }
    .art-top { font-size: 9px; }
    .art-caption { font-size: 25px; }
    .art-caption-small { font-size: 8px; }
    .hero .button { padding-inline: 14px; gap: 12px; }
    .intro-strip > .container { grid-template-columns: repeat(3, minmax(0, 1fr)); padding-block: 12px; }
    .intro-strip > .container > span { grid-column: 1 / -1; padding: 0 0 4px; }
    .intro-strip a { padding-inline: 14px; }
    .intro-strip a:first-of-type { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 767px) {
    .hero { grid-template-columns: minmax(0, 1fr); padding-block: 24px; gap: 22px; }
    .hero h1 { font-size: clamp(36px, 10.5vw, 48px); margin: 14px 0 12px; }
    .hero-english { font-size: 18px; }
    .hero-description { margin-top: 10px; }
    .hero .button-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 18px; }
    .hero .button { padding: 10px; gap: 8px; font-size: 13px; }
    .hero-art { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 8px 18px; min-height: 0; padding: 16px 18px; align-items: center; }
    .art-top { grid-column: 2; font-size: 9px; }
    .logo-mat { grid-column: 1; grid-row: 1 / 3; width: 72px; padding: 6px; margin: 0; }
    .art-bottom { grid-column: 2; gap: 8px; }
    .art-caption { font-size: 23px; }
    .art-caption-small { display: none; }
    .intro-strip > .container { grid-template-columns: .9fr 1fr 1.3fr; }
    .intro-strip > .container > span { font-size: 12px; }
    .intro-strip a { gap: 6px; padding-inline: 10px; font-size: 12px; line-height: 1.5; }
    .intro-strip a:last-child { padding-right: 0; }
  }
</style>
